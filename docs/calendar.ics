BEGIN:VEVENT
SUMMARY:Rajaton Jazz @ Art Jazz Club\, 9€
DTSTART;TZID=Europe/Helsinki:20150212T190000
DTEND;TZID=Europe/Helsinki:20150212T190000
DTSTAMP:20260805T071152Z
UID:f6hcf9v5c3a5ugdrebo2v46uac@google.com
